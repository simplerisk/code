# SimpleRisk Core: legacy URL redirects for simplerisk/admin/ (plan 4b).
# Shipped with every release and overwritten on upgrade -- do not edit locally.
# kind=restore: Settings Hub consolidation, pages deleted in shipped releases 20251118-001 .. 20260828-001.
# GET/HEAD answer 302, any other method 303 (never 307/308).
# Targets start with the install prefix (.*/) captured from REQUEST_URI by the last condition: a relative [R] target
# would put the filesystem directory into Location (verified on httpd 2.4.62, plan 4b Task 10).
<IfModule mod_rewrite.c>
RewriteEngine On

# legacy-redirect: added=20261105-001 kind=restore
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^about\.php$ %1admin/register.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^about\.php$ %1admin/register.php [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^active_assessments\.php$ %1admin/assessments.php#active-tab-pane [R=302,NE,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^active_assessments\.php$ %1admin/assessments.php#active-tab-pane [R=303,NE,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^assetvaluation\.php$ %1admin/settings_preferences.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^assetvaluation\.php$ %1admin/settings_preferences.php [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^(configure_risk_formula|review_settings)\.php$ %1admin/risk_configuration.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^(configure_risk_formula|review_settings)\.php$ %1admin/risk_configuration.php [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^content\.php$ %1admin/importexport.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^content\.php$ %1admin/importexport.php [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^extras\.php$ %1admin/index.php?tag=extras [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^extras\.php$ %1admin/index.php?tag=extras [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^(complianceforge|complianceforge_scf)\.php$ %1admin/securecontrolsframework.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^(complianceforge|complianceforge_scf)\.php$ %1admin/securecontrolsframework.php [R=303,QSD,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^fix_upload_encoding_issues\.php$ %1admin/data_integrity.php [R=302,QSD,L]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)admin/[^/]+$
RewriteRule ^fix_upload_encoding_issues\.php$ %1admin/data_integrity.php [R=303,QSD,L]
</IfModule>
